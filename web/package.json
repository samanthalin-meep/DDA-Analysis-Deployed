{
  "name": "dda-analysis-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/package-runner.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/package-runner.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "node scripts/package-runner.mjs && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@vercel/blob": "latest",
    "@vercel/sandbox": "latest",
    "lucide-react": "latest",
    "recharts": "latest",
    "workflow": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/node": "latest",
    "tsx": "latest"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
