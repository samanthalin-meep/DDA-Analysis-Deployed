{
  "name": "dda-analysis-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/package-runner.mjs && node scripts/package-desktop.mjs && next dev --hostname 0.0.0.0",
    "build": "node scripts/package-runner.mjs && node scripts/package-desktop.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "node scripts/package-runner.mjs && node scripts/package-desktop.mjs && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@novnc/novnc": "https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz",
    "@vercel/blob": "latest",
    "@vercel/sandbox": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "workflow": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "0.28.0",
    "tsx": "latest",
    "typescript": "latest"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  }
}
